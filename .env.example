# 数据库（PostgreSQL）
DATABASE_URL="postgresql://noteped:noteped@localhost:5432/noteped?schema=public"

# 认证（next-auth v4 使用 NEXTAUTH_ 前缀）
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# 邮件发送（SMTP，QQ 邮箱示例：需在邮箱设置开启 SMTP 服务并获取授权码）
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_USER="2976740045@qq.com"
SMTP_PASS="你的QQ邮箱授权码"

# AI（待定，预留）
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com"
